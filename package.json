{
  "name": "trip-planner",
  "version": "0.1.0",
  "description": "Trip planning app built on Next.js and Firebase",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest",
    "tsc": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "prepare": "husky",
    "env:validate": "node scripts/validate-config.mjs",
    "pins:check": "node scripts/check-package-pins.mjs",
    "backfill:transport-gap-count": "node scripts/backfill-transport-gap-count.mjs",
    "migrate:member-uids": "node scripts/migrate-member-uids.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@reduxjs/toolkit": "2.15.0",
    "@sentry/nextjs": "11.17.0",
    "@tanstack/react-query": "5.108.4",
    "@vercel/analytics": "2.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "13.4.0",
    "firebase-admin": "14.5.1",
    "lucide-react": "1.78.0",
    "mcp-handler": "2.4.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-redux": "9.3.1",
    "tailwind-merge": "3.7.1",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@babel/core": "7.29.13",
    "@eslint/js": "10.0.1",
    "@rolldown/plugin-babel": "0.3.1",
    "@storybook/addon-a11y": "10.6.8",
    "@storybook/addon-docs": "10.6.8",
    "@storybook/addon-vitest": "10.6.8",
    "@storybook/nextjs-vite": "10.6.8",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser": "5.1.1",
    "@vitest/browser-playwright": "5.1.1",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.15.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-boundaries": "7.4.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-storybook": "10.6.8",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.23.0",
    "storybook": "10.6.8",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "pnpm": {
    "overrides": {
      "jose": "^5.10.0"
    }
  }
}
